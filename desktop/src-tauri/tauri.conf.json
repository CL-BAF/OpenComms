{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenComms Desktop",
  "version": "0.0.1",
  "identifier": "dev.opencomms.desktop",
  "build": {
    "frontendDist": "../dist-shell"
  },
  "app": {
    "windows": [
      {
        "title": "OpenComms",
        "width": 1280,
        "height": 800,
        "url": "http://127.0.0.1:1455/"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:1455",
        "connect-src": "'self' http://127.0.0.1:1455",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": false,
    "externalBin": [
      "binaries/opencomms-coordinator"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}