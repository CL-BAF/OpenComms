{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenComms Tauri Desktop GUI",
  "version": "1.2.0",
  "identifier": "dev.opencomms.desktop",
  "build": {
    "frontendDist": "../dist-shell"
  },
  "app": {
    "windows": [
      {
        "title": "OpenComms Tauri Desktop GUI",
        "width": 1280,
        "height": 800,
        "url": "http://127.0.0.1:1455/"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:1455",
        "connect-src": "'self' http://127.0.0.1:1455",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "externalBin": [
      "binaries/opencomms-coordinator"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CL-BAF/OpenComms/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}