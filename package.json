{
  "name": "opencomms",
  "version": "1.1.0",
  "description": "OpenComms - a host-neutral, project-local TypeScript platform for multi-agent coding workflows: it links existing coding-agent sessions (OpenCode, Claude Code, Claude Desktop, Codex) into shared multi-agent channels (2-32 members, open role vocabulary) with autonomous push/pull delivery, per-member endpoint capabilities, session lifecycle (save/resume-as-new/delete), configurable loop-protection budgets, a loopback-only local GUI console, and a standalone CLI executable. Provider-native sessions are delivery endpoints only; host sessions are never created, owned, or replaced.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "bin": {
    "opencomms": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "install:plugin": "node install.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:bundle",
    "build:bundle": "node scripts/bundle.mjs --entry src/plugin.ts --format esm --outfile dist/plugin.bundled.js",
    "build:exe": "node scripts/build-exe.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:windows-release": "node scripts/test-windows-release.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/unit/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/unit/**/*.test.js\"",
    "test:contract": "npm run build:test && node --test --test-concurrency=1 dist-test/test/contract/*.test.js",
    "test:live": "npm run build:test && node --test --test-concurrency=1 --test-timeout=300000 dist-test/test/live/live.test.js",
    "test:all": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/unit/**/*.test.js\" dist-test/test/live/live.test.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@opencode-ai/sdk": "1.18.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0"
  }
}
