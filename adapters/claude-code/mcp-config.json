{
  "mcpServers": {
    "opencomms": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR}/.opencomms/opencomms-mcp.mjs", "${CLAUDE_PROJECT_DIR}", "--host", "claude-code"],
      "env": {
        "OPENCOMMS_MEMBER_ID": "${OPENCOMMS_MEMBER_ID:-}",
        "OPENCOMMS_MEMBER_ROLE": "${OPENCOMMS_MEMBER_ROLE:-}"
      }
    }
  }
}